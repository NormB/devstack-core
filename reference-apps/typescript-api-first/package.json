{
  "name": "devstack-core-typescript-api-first",
  "version": "1.0.0",
  "description": "TypeScript API-First reference implementation using OpenAPI code generation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "npm run build && jest",
    "generate": "openapi-generator-cli generate -i ../shared/openapi.yaml -g typescript-express-server -o ./generated"
  },
  "keywords": [
    "typescript",
    "openapi",
    "api-first",
    "vault",
    "microservices"
  ],
  "author": "DevStack Core Team",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.1",
    "mongodb": "^7.6.0",
    "mysql2": "^3.24.2",
    "node-vault": "^0.12.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.0",
    "redis": "^6.2.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/amqplib": "^0.10.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
